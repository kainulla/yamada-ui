{
  "extends": "@yamada-ui/workspace/typescript/tsconfig.json",
  "compilerOptions": {
    "paths": {
      "#storybook": ["./storybook"],
      "#test": ["./test"],
      "#test/browser": ["./test/browser"]
    },
    "types": ["vitest/globals", "@vitest/browser/providers/playwright"]
  },
  "include": ["**/*.ts", "**/*.tsx", "**/*.mts", "**/*.cts"],
  "exclude": [
    "node_modules",
    "trace",
    "dist",
    "coverage",
    "storybook-static",
    "**/chart/line-chart.namespace.ts",
    // "**/chart/chart.tsx",
    "**/chart/cartesian-chart.tsx",
    "**/chart/index.ts",
    "**/chart/line-chart.tsx",
    "**/chart/line-chart.stories.tsx"
  ]
}
